# Copy to .env and adjust DATABASE_URL

# Option A — Docker Postgres (local dev)
# DATABASE_URL="postgresql://postgres:password@localhost:5433/gemivora_cms?schema=public"

# Option B — Local PostgreSQL
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/gemivora_cms?schema=public"

# Option C — Railway PostgreSQL (production)
# Use the PRIVATE URL from Railway (linked Postgres service), not the public proxy.
# DATABASE_URL is injected automatically when you link Postgres to the backend service.
# For local migrations against Railway, use DATABASE_PUBLIC_URL with ?sslmode=require

JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development

CORS_ORIGIN="http://localhost:3000,http://localhost:3001,https://admin.creatd.it.com,https://creatd.it.com,https://www.creatd.it.com,https://company-frontend-liart.vercel.app,https://compnay-admin.vercel.app"
SITE_URL=https://www.creatd.it.com
ADMIN_URL=https://admin.creatd.it.com
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
AUTO_DB_SETUP=true

# Public HTTPS URL for /uploads (required in production)
PUBLIC_BASE_URL="https://company-backend-production-bb4b.up.railway.app"

# Blog AI — optional
# OPENROUTER_API_KEY="sk-or-v1-your-key-here"
# OPENROUTER_MODEL=openai/gpt-4o-mini

# One-time manual seed only (auto-seeds when user table is empty on first deploy)
RUN_DB_SEED=false
