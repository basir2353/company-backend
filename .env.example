# Copy to .env and adjust DATABASE_URL

# Option A — Docker Postgres (recommended for quick setup)
# Run: docker compose up -d
DATABASE_URL="postgresql://postgres:password@localhost:5433/gemivora_cms?schema=public"

# Option B — Local PostgreSQL (e.g. PostgreSQL 18 on Windows)
# Replace YOUR_POSTGRES_PASSWORD with the password you set during installation
# DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/gemivora_cms?schema=public"

# Option C — Render PostgreSQL (production)
# Paste Internal Database URL from Render dashboard
# SSL is added automatically in production
# DATABASE_URL="postgresql://user:pass@host/gemivora_cms?schema=public"

JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development
# No trailing slashes — must match browser Origin exactly
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,https://company-frontend-liart.vercel.app,https://compnay-admin.vercel.app"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
