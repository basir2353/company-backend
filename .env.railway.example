# ============================================================
# Railway → Backend service → Variables (PRODUCTION)
# Paste these into Railway. Do NOT commit real secrets.
# ============================================================

NODE_ENV=production

# Do NOT set PORT — Railway injects it.

# Link Postgres to this service so DATABASE_URL is private-network:
# DATABASE_URL is injected automatically when Postgres is linked.
# Prefer private URL (no public proxy / no egress cost).

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

PUBLIC_BASE_URL=https://company-backend-production-772f.up.railway.app
SITE_URL=https://www.creatd.it.com
ADMIN_URL=https://admin.creatd.it.com

CORS_ORIGIN=https://admin.creatd.it.com,https://creatd.it.com,https://www.creatd.it.com,https://company-frontend-liart.vercel.app,https://compnay-admin.vercel.app

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
AUTO_DB_SETUP=true
RUN_DB_SEED=false

# Optional — Blog AI
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=openai/gpt-4o-mini
